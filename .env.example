# FocusLens Backend Configuration
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focuslens
SESSION_SECRET=focuslens_super_secret_session_key_32_chars_min!
APP_BASE_URL=http://localhost:3001

# Email Provider Configuration (dev, smtp, resend, ethereal)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=onboarding@resend.dev

# SMS Provider Configuration (dev, twilio, messagebird)
SMS_PROVIDER=dev
SMS_ACCOUNT_ID=your_sms_account_id
SMS_AUTH_TOKEN=your_sms_auth_token
SMS_FROM_NUMBER=+18005550199

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3001

